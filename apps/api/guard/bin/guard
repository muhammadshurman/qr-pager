#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * The C1/C2 repo guard (R-010), run by `composer guard` and in CI.
 *
 * Deliberately standalone: no Laravel boot, no container, no database. §4 requires the
 * guard to be mechanical, and a guard that needs the application to boot cannot run
 * when the application is what is broken.
 */

require __DIR__.'/../src/Violation.php';
require __DIR__.'/../src/SourceGuard.php';

use Guard\SourceGuard;

$root = dirname(__DIR__, 2);
$guard = new SourceGuard($root);

$paths = array_slice($argv, 1);

// One source for the list -- SourceGuard::PATHS. It used to be spelled out here and
// again in RepoGuardTest, so the test could agree with its own copy while CI ran a
// different list.
$explicitPaths = $paths !== [];

if (! $explicitPaths) {
    $paths = SourceGuard::PATHS;
}

// Rule 6 FIRST: a path that resolves to nothing is a violation, because the alternative
// is this script reporting a pass for files it never opened (R-029's shape).
$violations = array_merge(
    $guard->scanScannablePaths($paths),
    $guard->scan($paths),
    $guard->scanConfiguredGucs(),
    // Rule 8 takes no path argument: its subject is the repository's own documents, two
    // levels above this guard's root, and it is the whole tree or nothing. Skipped when the
    // caller named explicit paths, so pointing the guard at one fixture still reports only
    // that fixture -- which is how every rule-N test in RepoGuardTest works.
    $explicitPaths ? [] : $guard->scanCanonicalDocs(),
    // Rule 9 takes no path argument either: its subject is `.github/workflows`, which is
    // neither PHP nor inside this guard's root. Same skip when explicit paths are named.
    $explicitPaths ? [] : $guard->scanWorkflowTriggers(),
);

if ($violations === []) {
    // The number of FILES READ, not the number of paths given. The old line said
    // "across 6 scanned path(s)" for a run that opened nothing.
    $files = count($guard->scannedFiles($paths));
    $count = count($paths);

    // Rules 8 and 9 read files that are not in $paths -- markdown two levels up, and the
    // workflow directory. The line used to name C1 and C2 only, which understated what a
    // green run had established; it now names what it checked and counts what it opened,
    // because "C1 and C2 hold" was also true of the run that read no workflow at all.
    $workflows = $explicitPaths ? 0 : count($guard->workflowFiles());
    // Rule 11 reads app/ and routes/ like rule 10, so it is covered by the file count
    // above rather than by a second one; it is NAMED because a green line that listed
    // only rules 9-10 would understate what the run established, which is the exact
    // shape this line was corrected for once already.
    $also = $explicitPaths ? '' : ", C7 and rules 9-11 across {$workflows} workflow(s) and the scanned tree";

    fwrite(STDOUT, "repo guard: C1 and C2 hold across {$files} file(s) in {$count} path(s){$also}.\n");

    exit(0);
}

fwrite(STDERR, 'repo guard: '.count($violations)." violation(s).\n\n");

foreach ($violations as $violation) {
    fwrite(STDERR, '  '.$violation."\n");
}

fwrite(STDERR, "\nC1: app.tenant_id and app.bypass_tenant are the only GUCs.\n");
fwrite(STDERR, "C2: always select set_config(name, value, true) -- third argument a literal true.\n");
fwrite(STDERR, "C7: one task table only, in docs/PLAN.md; one BLUEPRINT.md, nowhere else.\n");
fwrite(STDERR, "Rule 9: every pushed branch is evaluated -- on.push.branches includes ** (R-126).\n");
fwrite(STDERR, "Rule 10: object ACLs are not the application's to set -- ADR-004; a bucket policy instead.\n");
fwrite(STDERR, "Rule 11: a theme overrides TOKENS ONLY -- no <style, no CSS rule, one token list, one emitter.\n");
fwrite(STDERR, "All three are locked in PROJECT_INSTRUCTIONS.md §3; a change there comes first.\n");

exit(1);
