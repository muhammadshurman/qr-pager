#!/usr/bin/env bash
# Fails when packages/contracts/src/generated/status.ts is not what the PHP enum registry
# produces right now (§6.2, ADR-003).
#
# The sibling of bin/openapi-check and bin/landing-schema-check, and for the same reason in
# the same words: the contract is GENERATED, so the only way it can be wrong is by being
# stale, and a stale generated file is the quietest kind of wrong -- nothing fails and the
# file looks plausible. This is the step that makes it loud.
#
# WHAT IS DOWNSTREAM OF IT. apps/web, apps/site and packages/ui consume this file through
# @qrpager/contracts. There is no second definition of a status anywhere, which is §6's "one
# source only. Never a duplicated enum" -- so the day a screen renders a status, the thing it
# switches on cannot have drifted from the thing the service enforces.
#
# A BYTE DIFF, deliberately, not "does it parse". The committed file IS the contract and what
# matters is that it still matches the code. StatusMirror::encode() is the one place the
# encoding is decided, so the writer and this checker cannot disagree about formatting and
# report a stale file forever.
set -euo pipefail

cd "$(dirname "$0")/.."

export PAO_DISABLE=1

# `--check` does the comparison inside the command, where the generated bytes already are --
# so this script does not re-implement the encoding and cannot drift from it. A path override
# is deliberately NOT offered here: the test of THIS check drives the command directly, with
# its own --path pointing at a scratch copy.
php artisan contracts:export --check

# The second mirror, with its own source and its own way of going stale: `PublishedSite`'s key
# layout and hostname rule, which apps/site reads so it refuses a hostile `Host` with the rule
# the publisher refuses it with rather than a second one (ADR-005). Two commands, two messages:
# a single command writing both would fail in a way that names neither.
php artisan contracts:export-site-keys --check
