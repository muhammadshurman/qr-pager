#!/usr/bin/env bash
# Runs the §6 gate and KEEPS THE OUTPUT, which is the whole point of the script.
#
# THE FAILURE THIS EXISTS FOR. A full suite run on this branch went red once at 363
# passed and the identity of the failing test was never captured, because what was
# recorded was a one-line summary rather than the output. "13 of 14 green, one
# unexplained" was then the honest state of the suite for a week, and an unidentified
# flake is the most expensive defect shape this branch has (§4a records four). The cause
# is now identified -- two concurrent runners and an unserialized TRUNCATE, PLAN.md
# R-049 -- and it was identified in one run, by a run whose output went to a file.
#
# So: every step's full output is tee'd to one file under storage/logs (git-ignored),
# the path is printed before the first step and again at the end, and the file survives
# the run. A red run leaves the test name, the exception class, the SQLSTATE, the source
# excerpt and the frame list on disk.
#
# NOT A REPLACEMENT FOR THE THREE COMMANDS in PROJECT_INSTRUCTIONS.md §6 -- it runs
# them, in the gate's own order, plus the five generated-artifact and architecture steps
# the tasks since have added (guard, deptrac, openapi:check, Task 7's landing:check, and
# Task 8a's contracts:check). Running the three by hand stays correct; this is the form
# that leaves evidence.
#
# Task 8a's FRONTEND gate is not run from here, deliberately. This script is apps/api's and
# runs from apps/api; the workspace gate is `pnpm gate` from the repository root, and CI runs
# the two as separate jobs (ADR-003: "CI gains a second job for the frontend workspace").
# One script spanning both halves would make a PHP failure and a TypeScript failure
# indistinguishable in the log, which is the opposite of what this file exists for.
#
# The closing line counts the array rather than naming a number, because it said "all six
# steps green" for the whole of Task 7's build while running seven.
#
# First failure stops the run: a stan error makes the suite's result uninteresting, and
# a half-read log is worse than a short one.
set -uo pipefail

cd "$(dirname "$0")/.."

# R-054, and the reason that row existed: WHAT THIS LOG CONTAINS DEPENDED ON WHO RAN IT.
#
# laravel/pao replaces the console output style whenever
# Laravel\AgentDetector\AgentDetector::detect()->isAgent -- a detector over ~40 vendor
# environment variables (AI_AGENT, CLAUDECODE, CURSOR_AGENT, CODEX_*, GEMINI_CLI and the
# rest), plus some compound conditions and a filesystem probe. Inside an agent session
# `php artisan test` therefore prints ONE JSON LINE; in an ordinary terminal it prints
# Pest's normal output. Measured 2026-10-27: unsetting AI_AGENT alone still gave JSON,
# unsetting CLAUDECODE alone still gave JSON, unsetting both gave the normal output --
# any one indicator is enough.
#
# That is what made R-054 true: the JSON path carries failures[].test/.file/.line/
# .message and no frame list at all for an assertion failure, so the gate's own promise
# of "the stack" was false for whoever happened to run it from a tool. It was never a
# property of this script, which is why the row read as unfixable without narrowing the
# claim.
#
# PAO_DISABLE is that package's own off switch and it is checked before every other
# condition (vendor/laravel/pao/src/Laravel/ServiceProvider.php:22). Exported here rather
# than unsetting the detector's variables one by one: that list belongs to the package and
# would go stale the next time an agent vendor is added, which is the duplicated-list
# shape QA H-1 already cost this project once.
#
# So the claim above is KEPT rather than narrowed, and it is now true for every runner.
export PAO_DISABLE=1

log="storage/logs/gate-$(date -u +%Y%m%dT%H%M%SZ).log"
: >"$log"

echo "gate: full output -> $(pwd)/$log"
echo

# THE NAMED KNOWN-FLAKE LIST, PRINTED INTO EVERY LOG WHETHER THE RUN GOES RED OR NOT.
#
# Task 9's gate says "all previous tasks' tests still pass". Two live intermittent families
# ride in this suite, so without a named list that clause cannot be discharged honestly --
# any new red can be attributed to one of them by assertion, and R-185 is this ledger's own
# row about §6's clause being satisfied probabilistically rather than demonstrably.
#
# So the list is tests/known-flakes.json and it is reported SEPARATELY from failures: on a
# red, bin/classify-reds splits the run into ATTRIBUTED reds (a named row, its owner, its
# measured rate) and REAL reds (on no row). A red outside the list is a real red.
#
# Printed on a GREEN run too, deliberately. A log that names the list is a log in which the
# list's own staleness is visible -- an entry whose row has been closed should be gone, and
# that is only noticeable if somebody sees it.
php bin/known-flakes-summary 2>&1 | tee -a "$log"
echo | tee -a "$log"

# composer's own scripts, so this cannot drift from what CI runs.
steps=(
  "composer pint"
  "composer stan"
  "composer guard"
  "composer deptrac"
  "composer openapi:check"
  "composer landing:check"
  "composer contracts:check"
  # ⚠ BEFORE THE SUITE, AND THAT ORDER IS THE WHOLE REASON IT IS HERE. Task 8b's
  # ->viteTheme() makes public/build/manifest.json a PREREQUISITE of every test that
  # renders a panel page, and public/build is git-ignored. Measured with it moved aside:
  # PlatformPanelAccessibilityTest went 13 passed -> 7 failed, each failure a generic 500
  # body naming nothing. bin/assets also checks the manifest against the themes the
  # providers register, which a successful build does NOT do.
  "composer assets"
  # Known CVEs in apps/api's OWN npm tree -- the half of §11.7 that stopped at the pnpm
  # workspace. `pnpm audit` reads pnpm-lock.yaml and licences.test.mjs walks the pnpm
  # store, so 92 packages under apps/api were covered by neither. The licence half is
  # ApiNpmLicenceTest, in the suite below; this is the network call, which an assertion
  # cannot be. Fails closed on an unreachable registry: an unmeasured tree is not a pass.
  "composer deps"
  "php artisan test"
)

for step in "${steps[@]}"; do
  echo "=== $step" | tee -a "$log"

  # tee so the operator sees it live AND the file has it; pipefail so the status is the
  # step's and not tee's.
  if ! $step 2>&1 | tee -a "$log"; then
    echo | tee -a "$log"
    echo "gate: FAILED at '$step'. Full output: $(pwd)/$log" | tee -a "$log" >&2

    # ONLY THE SUITE STEP IS CLASSIFIED. A pint, stan, guard, deptrac, assets or deps
    # failure has nothing to do with a flaky test and feeding one to the classifier would
    # print "no FAILED block" and say nothing useful. The nine steps above are
    # deterministic; the suite is the only one with intermittents in it.
    if [ "$step" = "php artisan test" ]; then
      php bin/classify-reds "$log" 2>&1 | tee -a "$log"
      verdict=${PIPESTATUS[0]}

      if [ "$verdict" -eq 2 ]; then
        echo "gate: ATTRIBUTED RED -- every failure matches a named row. Exit 2." | tee -a "$log" >&2
        exit 2
      fi
    fi

    exit 1
  fi

  echo | tee -a "$log"
done

echo "gate: all ${#steps[@]} steps green. Full output: $(pwd)/$log" | tee -a "$log"
