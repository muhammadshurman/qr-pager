#!/usr/bin/env bash
# Fails when docs/contracts/landing-page.schema.json is not what the PHP block schema
# produces right now (§6.2, QRPAGER-14 decision D4).
#
# The sibling of bin/openapi-check, and for the same reason in the same words: the
# contract is GENERATED, so the only way it can be wrong is by being stale, and a stale
# generated file is the quietest kind of wrong -- nothing fails and the file looks
# plausible. This is the step that makes it loud.
#
# WHAT IS DOWNSTREAM OF IT. Task 11's Next.js renderer consumes this document. There is no
# second definition of a block anywhere, which is §6's "one source only. Never a duplicated
# enum" applied to a shape rather than to an enum -- so the day the renderer is written,
# the thing it validates against cannot have drifted from the thing the builder enforces.
#
# A BYTE DIFF, deliberately, not "does it parse". The committed file IS the contract and
# what matters is that it still matches the code. LandingSchema::encode() is the one place
# the encoding is decided, so the writer and this checker cannot disagree about flags and
# report a stale file forever.
set -euo pipefail

cd "$(dirname "$0")/.."

export PAO_DISABLE=1

# `--check` does the comparison inside the command, where the generated bytes already
# are -- so this script does not re-implement the encoding and cannot drift from it.
# A path override is deliberately NOT offered: unlike the OpenAPI check there is nothing
# to point at a scratch copy, because the test of THIS check drives the command directly.
php artisan landing:schema-export --check
