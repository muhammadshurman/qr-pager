#!/usr/bin/env bash
# Task 6: revert-prove the two clauses this task actually ships on.
#
# WHAT IT PROVES, and why each needs a revert rather than a reading:
#
#   REVERT A — the TRANSACTIONAL clause. `§3` row 6: "the wizard is transactional -- a
#   failure halfway leaves no partial tenant." withTenant() opens one transaction around
#   the tenants insert, the membership insert and the tenant's audit row, so a failure at
#   step 4 of 5 leaves none of them. Replacing that one wrapper with three unwrapped
#   statements is the smallest edit that makes the clause false, and the case that is
#   supposed to notice is the one the ticket's §6 Q6 asks by name.
#
#   REVERT B — the NAMED INVARIANT. "No panel query reaches a tenant table." The listener
#   assertion is only worth something if it goes red when a statement DOES reach one, so
#   this adds a single harmless `select ... from tenants` to the panel's own read path.
#   A test that cannot be made red by the thing it forbids is a test that would have been
#   green however the panel was written -- which is the state four assertions in this
#   repository were measured to be in (§4a's FOUR DEAD ASSERTIONS).
#
# A red here counts as evidence only when it is the ASSERTION failing. bin/_revert-proof.sh
# is what enforces that, plus a green baseline and unmoved controls -- the lesson of the
# lease proof, where sixteen exception-reds were published as coverage.
#
# It edits tracked files and restores them in a trap, including on Ctrl-C. Run it on a
# clean tree: if it is interrupted hard enough to skip the trap, `git checkout` the files.
set -uo pipefail

cd "$(dirname "$0")/.."

# shellcheck source=bin/_revert-proof.sh
. "$(dirname "$0")/_revert-proof.sh"

service="app/Features/Provisioning/TenantProvisioning.php"
dashboard="app/Features/Provisioning/Panel/PlatformDashboard.php"

service_backup="$(mktemp)"
dashboard_backup="$(mktemp)"

cp "$service" "$service_backup"
cp "$dashboard" "$dashboard_backup"

restore() {
  cp "$service_backup" "$service"
  cp "$dashboard_backup" "$dashboard"
}

trap 'restore; rm -f "$service_backup" "$dashboard_backup"; revert_proof_cleanup' EXIT INT TERM

# THE CONTROLS. Cases that must stay GREEN under BOTH reverts, because neither revert can
# touch what they are about:
#
#   - the duplicate-slug refusal is decided by a unique index on a PLATFORM table, before
#     any tenant-side work and before the panel reads anything;
#   - the redacted failure message is a property of reasonFor()'s SQLSTATE mapping, not of
#     where the transaction boundary is;
#   - the registry row's own shape is written by request(), which neither revert edits.
#
# Declared so the machinery checks them. A proof with a declared control is worth exactly
# what checking the control is worth.
revert_proof_init \
  "tests/Feature/Platform/TenantProvisioningTest.php tests/Feature/Platform/PlatformPanelInvariantTest.php" \
  "refuses a duplicate slug with a typed failure" \
  "never puts the driver message in the duplicate-slug failure" \
  "lower-cases the owner email before it is stored"

run() { revert_proof_run "$@"; }

echo "Task 6 revert proof — $(git rev-parse --short HEAD), $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo

run "baseline — no revert, every case should pass" baseline

# ---------------------------------------------------------------------------------------
# REVERT A: the one transaction becomes three loose statements.
#
# withTenant() is both the context AND the transaction (PLAN.md §2.2), so it cannot simply
# be deleted -- the inserts would then run with no tenant context at all and be refused
# 42501, which is a driver error and NOT the assertion failing, so the machinery would
# reject it as evidence. The edit therefore keeps a context per statement and removes the
# single boundary around all three, which is exactly the "partial tenant" shape.
# ---------------------------------------------------------------------------------------
restore

python3 - "$service" <<'PY'
import sys, re
path = sys.argv[1]
s = open(path, encoding='utf-8').read()

open_marker  = "            withTenant($tenantId, function () use ($tenantId, $row): void {"
close_marker = "            });"

start = s.index(open_marker)
end = s.index(close_marker, start)

body = s[start + len(open_marker):end]

# Three separate withTenant() calls, one per statement: same context, no shared boundary.
stmts = [b for b in re.split(r'\n(?=\s*DB::insert\()', body) if 'DB::insert(' in b]
assert len(stmts) == 3, f"expected 3 inserts in the provisioning transaction, found {len(stmts)}"

rebuilt = "            // REVERTED BY bin/provisioning-revert-proof: one transaction -> three\n"
for stmt in stmts:
    rebuilt += "            withTenant($tenantId, function () use ($tenantId, $row): void {\n"
    rebuilt += stmt.rstrip('\n') + "\n"
    rebuilt += "            });\n"

# resolveOwner() was called inside the old body; it has to stay reachable for insert 2.
rebuilt = rebuilt.replace(
    "$ownerUserId = $this->resolveOwner((string) $row->owner_email);",
    "$ownerUserId = $this->resolveOwner((string) $row->owner_email);",
)

s = s[:start] + rebuilt.rstrip('\n') + s[end + len(close_marker):]
open(path, 'w', encoding='utf-8').write(s)
print("revert A applied")
PY

grep -q 'REVERTED BY bin/provisioning-revert-proof' "$service" \
  || { echo "FATAL: revert A did not apply"; exit 1; }

run "revert A — the provisioning transaction split into three"

# ---------------------------------------------------------------------------------------
# REVERT B: the panel reads a tenant table.
#
# One extra statement on the dashboard's own read path, against `tenants`. Harmless to the
# data and fatal to the invariant, which is the point: if the listener assertion does not
# turn red here, it would have stayed green whatever the panel did.
# ---------------------------------------------------------------------------------------
restore

python3 - "$dashboard" <<'PY'
import sys
path = sys.argv[1]
s = open(path, encoding='utf-8').read()

needle = "    public function summary(): PlatformSummary\n    {\n"
i = s.index(needle)
inject = (
    "        // REVERTED BY bin/provisioning-revert-proof: a panel query that reaches a\n"
    "        // tenant table, which the named invariant forbids.\n"
    "        DB::select('select count(*) from tenants');\n\n"
)
s = s[:i + len(needle)] + inject + s[i + len(needle):]
open(path, 'w', encoding='utf-8').write(s)
print("revert B applied")
PY

grep -q 'REVERTED BY bin/provisioning-revert-proof' "$dashboard" \
  || { echo "FATAL: revert B did not apply"; exit 1; }

run "revert B — the dashboard reads the tenants table"

# RESTORE HERE EXPLICITLY, not only in the trap: the check below needs something true to
# check, and the trap has not fired yet on the normal path.
restore

for pair in "$service:$service_backup" "$dashboard:$dashboard_backup"; do
  file="${pair%%:*}"; copy="${pair##*:}"
  if cmp -s "$copy" "$file"; then
    echo "restored: $file is byte-identical to the copy taken before the first revert"
  else
    echo "WARNING: $file does NOT match the pre-run copy. Restore it from git." >&2
    exit 1
  fi
done

echo

revert_proof_verdict "provisioning-revert-proof" || exit 1
