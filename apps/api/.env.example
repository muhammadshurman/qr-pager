APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Which peers may set X-Forwarded-For, and therefore what the per-IP rate limit counts.
# Empty here on purpose: local has no proxy, so the peer IS the client. Outside
# local/testing the boot check REFUSES to serve on an empty value and on every spelling
# of a catch-all -- '*', '**', any /0 prefix, the literal REMOTE_ADDR, a prefix wider
# than /8 (IPv4) or /32 (IPv6), and a LIST whose entries cover a whole family between
# them, such as 0.0.0.0/1,128.0.0.0/1. See config/trustedproxy.php for why a catch-all is
# worse than empty, and for the single-ingress assumption the CIDR depends on. Task 13
# supplies the real VPC CIDR.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qrpager
DB_USERNAME=qrpager_app
# Local-only, and the same value compose.yaml hands Postgres. Every deployed
# environment takes these from Secrets Manager; nothing here is a real credential.
DB_PASSWORD=local_dev_only

# Migration and bootstrap credentials. These belong to the migration/CI environment
# only -- a runtime task carries DB_USERNAME/DB_PASSWORD and nothing else (PLAN.md §2.1).
DB_OWNER_USERNAME=qrpager_owner
DB_OWNER_PASSWORD=local_dev_only
DB_WORKER_USERNAME=qrpager_worker
DB_WORKER_PASSWORD=local_dev_only
DB_ROOT_USERNAME=qrpager_root
DB_ROOT_PASSWORD=local_dev_only
DB_MAINTENANCE_DATABASE=postgres

# The compose Postgres has no TLS, so the local opt-out is explicit. Anything
# deployed leaves this unset and gets 'require' from config/database.php, or sets
# verify-full with a CA bundle (PLAN.md §5 R-008, Task 13).
DB_SSLMODE=disable

# Where a scanned QR code lands. The raw token is appended as this URL's FRAGMENT, which
# is the one place in a URL a server never receives (PagerToken::qrPayload). That makes
# the SCHEME the protection: over http:// the page is modifiable in flight and one
# injected script reading location.hash has the token. Outside local/testing the boot
# check REFUSES to serve unless this is an absolute https:// URL with a host and no
# fragment of its own. Task 7 makes the host a per-tenant attribute (S2, custom domains);
# until then it is one value for the whole app and this is the fallback.
PAGER_LANDING_URL=https://localhost/p

# Web Push identity (RFC 8292). NAMES ONLY -- there is deliberately no value here, not
# even a working test one. A committed "test" key is a committed key: it is
# indistinguishable from a real one in a diff and in a secret scan, and the next person
# who needs a working local setup copies it. Every test generates its own pair at
# runtime, which is why the suite needs none of these set.
#
# Generate a pair with:
#   php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
#
# Outside local/testing the boot check REFUSES to serve unless all three are set AND the
# pair is one the push library accepts -- because an empty or mismatched key fails inside
# the dispatcher, so every notification would retry and then dead-letter while every page
# and every subscription kept working. A pager that looks healthy and never buzzes is the
# one failure this product cannot have.
#
# Rotating the pair invalidates every subscription in the database: a browser pins its
# subscription to the public key it was given. That is a migration, not a config change.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The staff session cookie carries a CREDENTIAL from Task 5 on: the tenant selection and the
# WebAuthn challenge both live in it. Found by Task 5's security review; the setting was
# never named in this file, and `cp .env.example .env` is this project's documented
# bootstrap, so "unset" was what a fresh clone got.
#
# ⚠ WHAT UNSET ACTUALLY DOES, corrected after the `§11` review of the fix diff (QA L-10):
# this comment said an unset value "means the cookie is sent over plaintext HTTP". It does
# not. `config/session.php` reads `env('SESSION_SECURE_COOKIE')` -> null, Laravel passes the
# null through, and Symfony's `Response::prepare()` then sets the Secure default from
# `$request->isSecure()`. So unset means "Secure IFF the request arrived over HTTPS".
#
# Setting it `true` is still the right change, for a reason worth stating precisely: it makes
# the flag UNCONDITIONAL, so it no longer depends on the request scheme being seen correctly
# -- and behind a proxy that is `TrustProxies` being configured right, which this repository
# has a whole family of rows about (`R-027`'s neighbours, and `config/trustedproxy.php`'s own
# boot check).
#
# `true` is safe for local work: browsers treat `http://localhost` as a secure context and
# send Secure cookies to it. A dev machine reached over a LAN ADDRESS rather than localhost
# is the one case where this needs turning off -- worth knowing before Task 9 drives the
# passkey harness from a browser.
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit, from compose.yaml (ADR-002). 1025 is SMTP; 8025 is the HTTP API a test reads a
# delivered message back out of, which is what "asserted against the local mail catcher"
# requires -- SMTP proves a message was ACCEPTED, the API proves one EXISTS.
# Was `log` with port 2525 until 2026-10-28, pointing at nothing (R-125).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_CATCHER_URL=http://127.0.0.1:8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The local object store, from compose.yaml (ADR-004, which supersedes ADR-002's MinIO row:
# MinIO publishes no image a clone holding no credentials can pull). 8333 is SeaweedFS's S3
# API, and these are the credentials the service itself is started with -- without them it
# accepts any signature. Production overrides the two keys, drops AWS_ENDPOINT and sets
# path-style back to false; nothing else differs, because the driver is the same one.
AWS_ACCESS_KEY_ID=qrpager
AWS_SECRET_ACCESS_KEY=local_dev_only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=qrpager-local
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AUTH (Task 5) -- Fortify + Sanctum + WebAuthn passkeys + 2FA
# ---------------------------------------------------------------------------
#
# BOTH ARE OPTIONAL AND BOTH ARE LISTED ANYWAY, which is the point of this file:
# PLAN.md R-083's sibling finding at Task 3 was a config key the application needed
# and .env.example did not name (security S-5), so a fresh clone booted without it
# and nobody could tell from the file.
#
# PASSKEYS_USER_HANDLE_SECRET derives the stable WebAuthn user handle. It defaults to
# APP_KEY, which is correct and has one consequence worth knowing: ROTATING APP_KEY
# INVALIDATES EVERY REGISTERED PASSKEY, because the handle every authenticator stored
# no longer matches. Set this explicitly before the first production passkey if APP_KEY
# will ever be rotated.
PASSKEYS_USER_HANDLE_SECRET=

# A prefix on issued Sanctum tokens so a secret scanner can recognise a leaked one by
# shape. Empty on purpose at this task: a prefix is only useful once gitleaks has a rule
# for it, and adding both is Task 12's dependency-and-secret-scanning pass.
SANCTUM_TOKEN_PREFIX=

# The WebAuthn relying party is derived from APP_URL's host, and the allowed origin from
# APP_URL itself (vendor config/passkeys.php defaults, not published). A passkey is BOUND
# to the relying party id, so changing APP_URL's HOST invalidates every passkey
# registered against the old one -- which is a deployment fact rather than a setting, and
# is recorded here because APP_URL above looks like an innocuous value.
