APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Which peers may set X-Forwarded-For, and therefore what the per-IP rate limit counts.
# Empty here on purpose: local has no proxy, so the peer IS the client. Outside
# local/testing the boot check REFUSES to serve on an empty value and on '*' -- see
# config/trustedproxy.php for why '*' is worse than empty, and for the single-ingress
# assumption the CIDR depends on. Task 13 supplies the real VPC CIDR.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qrpager
DB_USERNAME=qrpager_app
# Local-only, and the same value compose.yaml hands Postgres. Every deployed
# environment takes these from Secrets Manager; nothing here is a real credential.
DB_PASSWORD=local_dev_only

# Migration and bootstrap credentials. These belong to the migration/CI environment
# only -- a runtime task carries DB_USERNAME/DB_PASSWORD and nothing else (PLAN.md §2.1).
DB_OWNER_USERNAME=qrpager_owner
DB_OWNER_PASSWORD=local_dev_only
DB_WORKER_USERNAME=qrpager_worker
DB_WORKER_PASSWORD=local_dev_only
DB_ROOT_USERNAME=qrpager_root
DB_ROOT_PASSWORD=local_dev_only
DB_MAINTENANCE_DATABASE=postgres

# The compose Postgres has no TLS, so the local opt-out is explicit. Anything
# deployed leaves this unset and gets 'require' from config/database.php, or sets
# verify-full with a CA bundle (PLAN.md §5 R-008, Task 13).
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
