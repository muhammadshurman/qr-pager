# One place that decides how the workspace resolves, so a fresh clone and CI agree.
#
# engine-strict: the Node floor in package.json's `engines` is a REFUSAL, not advice.
# The floor is 22.12.0 and it is Vitest 5's, not Next's -- vitest's own engines field is
# `^22.12.0 || ^24.0.0 || >=26.0.0`, which excludes Node 23 and 25, while next@15.5.28 asks
# only for >=20.0.0. Without this line a clone on Node 20 installs happily and fails later,
# somewhere that does not name the cause.
engine-strict=true

# No implicit hoisting to the root node_modules. A package that imports something it does
# not declare works by accident under a hoisted layout and breaks the moment the tree is
# resolved differently -- which is exactly what a fresh clone does. §6's "nothing that only
# exists on the builder's machine" is unprovable under a hoisted tree.
hoist=false

# Exact versions on `pnpm add`, so nothing arrives by a caret nobody chose. playwright in
# particular MUST be exact: its browser build is tied to the package version, so a range
# re-downloads a different Chromium and CI then tests against a browser nobody verified.
save-exact=true
