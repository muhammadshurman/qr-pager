{
    "openapi": "3.1.2",
    "info": {
        "title": "QR Pager API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "paths": {
        "/healthz": {
            "get": {
                "operationId": "probe.health",
                "description": "Answers 200 while this worker can execute PHP. It reads no dependency, so it\ncannot fail because Postgres or Redis is unavailable, and it is never shed.",
                "summary": "Liveness probe",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "alive"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "operationId": "probe.readiness",
                "description": "200 when the last probe is fresh and both dependencies were up; 503 otherwise,\nwith `reason` naming which. Opens no database connection.\n\nONE RETURN, with the body as a literal array, and that shape is for the generated\nspec rather than for taste. Scramble infers a response schema from what a\ncontroller actually returns: with the body built in a private helper the exported\ndocument described this endpoint as `{\"type\":\"string\"}` -- a generated spec that is\nwrong in the quietest possible way, since nothing fails and the file looks\nplausible. \u00a77's own caveat said as much (\"a controller must return a declared\n     * shape rather than one branch's literals\"), and this is that caveat met.",
                "summary": "Readiness probe",
                "tags": [
                    "Readiness"
                ],
                "responses": {
                    "503": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ready": {
                                            "type": "boolean"
                                        },
                                        "reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "redis is not reachable",
                                                "postgres is not reachable",
                                                "the readiness snapshot is stale",
                                                "no readiness snapshot is available",
                                                null
                                            ]
                                        },
                                        "probe": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "properties": {
                                                "postgres_up": {
                                                    "type": "boolean"
                                                },
                                                "redis_up": {
                                                    "type": "boolean"
                                                },
                                                "app_backends": {
                                                    "type": "integer"
                                                },
                                                "app_limit": {
                                                    "type": "integer"
                                                },
                                                "saturation": {
                                                    "type": "number"
                                                },
                                                "measured_at": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "postgres_up",
                                                "redis_up",
                                                "app_backends",
                                                "app_limit",
                                                "saturation",
                                                "measured_at"
                                            ]
                                        },
                                        "probe_age_seconds": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "freshness_budget_seconds": {
                                            "type": "integer"
                                        }
                                    },
                                    "required": [
                                        "ready",
                                        "reason",
                                        "probe",
                                        "probe_age_seconds",
                                        "freshness_budget_seconds"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ready": {
                                            "type": "boolean"
                                        },
                                        "reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "redis is not reachable",
                                                "postgres is not reachable",
                                                "the readiness snapshot is stale",
                                                "no readiness snapshot is available",
                                                null
                                            ]
                                        },
                                        "probe": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "properties": {
                                                "postgres_up": {
                                                    "type": "boolean"
                                                },
                                                "redis_up": {
                                                    "type": "boolean"
                                                },
                                                "app_backends": {
                                                    "type": "integer"
                                                },
                                                "app_limit": {
                                                    "type": "integer"
                                                },
                                                "saturation": {
                                                    "type": "number"
                                                },
                                                "measured_at": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "postgres_up",
                                                "redis_up",
                                                "app_backends",
                                                "app_limit",
                                                "saturation",
                                                "measured_at"
                                            ]
                                        },
                                        "probe_age_seconds": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "freshness_budget_seconds": {
                                            "type": "integer"
                                        }
                                    },
                                    "required": [
                                        "ready",
                                        "reason",
                                        "probe",
                                        "probe_age_seconds",
                                        "freshness_budget_seconds"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}