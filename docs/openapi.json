                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session cannot move to that state.",
                        "content": {
                            "application/json": {
