{
    "openapi": "3.1.2",
    "info": {
        "title": "QR Pager API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "paths": {
        "/healthz": {
            "get": {
                "operationId": "probe.health",
                "description": "Answers 200 while this worker can execute PHP. It reads no dependency, so it\ncannot fail because Postgres or Redis is unavailable, and it is never shed.",
                "summary": "Liveness probe",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "alive"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/pager-sessions": {
            "post": {
                "operationId": "pager.sessions.store",
                "description": "Issues a single-use token for one order and returns the payload to encode in a QR\ncode. The token is returned by this call only and cannot be retrieved afterwards.",
                "summary": "Create a pager session",
                "tags": [
                    "PagerSession"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreatePagerSessionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The session, and the QR payload to encode.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer",
                                                    "const": 0
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        },
                                        "qr_payload": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "session",
                                        "qr_payload"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The order reference did not pass validation.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDocument"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/pager-sessions/{session}/ready": {
            "post": {
                "operationId": "pager.sessions.ready",
                "description": "Safe to repeat: calling this again on a session that is already ready changes\nnothing and sends no second notification.",
                "summary": "Mark an order ready and notify the customer",
                "tags": [
                    "PagerSession"
                ],
                "parameters": [
                    {
                        "name": "session",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The session state after the call.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session cannot move to that state.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/pager-sessions/{session}/renotify": {
