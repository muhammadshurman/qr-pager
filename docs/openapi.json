{
    "openapi": "3.1.2",
    "info": {
        "title": "QR Pager API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "security": [
        {
            "staffBearer": []
        }
    ],
    "paths": {
        "/healthz": {
            "get": {
                "operationId": "probe.health",
                "description": "Answers 200 while this worker can execute PHP. It reads no dependency, so it\ncannot fail because Postgres or Redis is unavailable, and it is never shed.",
                "summary": "Liveness probe",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "alive"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ]
            }
        },
        "/v1/pager-sessions": {
            "post": {
                "operationId": "pager.sessions.store",
                "description": "Issues a single-use token for one order and returns the payload to encode in a QR\ncode. The token is returned by this call only and cannot be retrieved afterwards.",
                "summary": "Create a pager session",
                "tags": [
                    "PagerSession"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreatePagerSessionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The session, and the QR payload to encode.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer",
                                                    "const": 0
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        },
                                        "qr_payload": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "session",
                                        "qr_payload"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The order reference did not pass validation.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDocument"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No authenticated staff user. Every endpoint here requires one; the body carries no detail about why.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "staffBearer": []
                    }
                ]
            }
        },
        "/v1/pager-sessions/{session}/ready": {
            "post": {
                "operationId": "pager.sessions.ready",
                "description": "Safe to repeat: calling this again on a session that is already ready changes\nnothing and sends no second notification. A session that has passed its two-hour\nexpiry is refused; issue a new session instead.",
                "summary": "Mark an order ready and notify the customer",
                "tags": [
                    "PagerSession"
                ],
                "parameters": [
                    {
                        "name": "session",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The session state after the call.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No authenticated staff user. Every endpoint here requires one; the body carries no detail about why.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session cannot move to that state, or has passed its expiry. The `type` member distinguishes the two.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "staffBearer": []
                    }
                ]
            }
        },
        "/v1/pager-sessions/{session}/renotify": {
            "post": {
                "operationId": "pager.sessions.renotify",
                "description": "Requires a session that has already been marked ready, and is limited to a fixed\nnumber of repeats per session.",
                "summary": "Send the ready notification again",
                "tags": [
                    "PagerSession"
                ],
                "parameters": [
                    {
                        "name": "session",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The session state after the call.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No authenticated staff user. Every endpoint here requires one; the body carries no detail about why.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session is not ready, has reached its repeat limit, or has passed its expiry. The `type` member distinguishes them.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "staffBearer": []
                    }
                ]
            }
        },
        "/v1/pager-sessions/{session}/complete": {
            "post": {
                "operationId": "pager.sessions.complete",
                "description": "Sends no notification: the customer is at the counter. Safe to repeat.",
                "summary": "Mark an order collected",
                "tags": [
                    "PagerSession"
                ],
                "parameters": [
                    {
                        "name": "session",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The session state after the call.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No authenticated staff user. Every endpoint here requires one; the body carries no detail about why.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session cannot move to that state, or has passed its expiry. The `type` member distinguishes the two.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "staffBearer": []
                    }
                ]
            }
        },
        "/v1/pager-sessions/{session}/cancel": {
            "post": {
                "operationId": "pager.sessions.cancel",
                "description": "Notifies, so that a customer waiting on a pager that will never go off is told.\nSafe to repeat.",
                "summary": "Cancel an order and tell the customer",
                "tags": [
                    "PagerSession"
                ],
                "parameters": [
                    {
                        "name": "session",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The session state after the call.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "session": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "status": {
                                                    "type": "string"
                                                },
                                                "order_reference": {
                                                    "type": "string"
                                                },
                                                "renotify_count": {
                                                    "type": "integer"
                                                },
                                                "changed": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "status",
                                                "order_reference",
                                                "renotify_count",
                                                "changed"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "session"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No authenticated staff user. Every endpoint here requires one; the body carries no detail about why.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such session in this tenant.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The session cannot move to that state, or has passed its expiry. The `type` member distinguishes the two.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDocument"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "staffBearer": []
                    }
                ]
            }
        },
        "/readyz": {
            "get": {
                "operationId": "probe.readiness",
                "description": "200 when the last probe is fresh and both dependencies were up; 503 otherwise,\nwith `reason` naming which. Opens no database connection.",
                "summary": "Readiness probe",
                "tags": [
                    "Readiness"
                ],
                "responses": {
                    "503": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ready": {
                                            "type": "boolean"
                                        },
                                        "reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "redis is not reachable",
                                                "postgres is not reachable",
                                                "the readiness snapshot is stale",
                                                "no readiness snapshot is available",
                                                null
                                            ]
                                        },
                                        "probe_age_seconds": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "ready",
                                        "reason",
                                        "probe_age_seconds"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ready": {
                                            "type": "boolean"
                                        },
                                        "reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "redis is not reachable",
                                                "postgres is not reachable",
                                                "the readiness snapshot is stale",
                                                "no readiness snapshot is available",
                                                null
                                            ]
                                        },
                                        "probe_age_seconds": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "ready",
                                        "reason",
                                        "probe_age_seconds"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "no-store"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "staffBearer": {
                "type": "http",
                "description": "Staff and admin endpoints require an authenticated user. The credential is issued by Task 5's auth surface (Fortify + Sanctum), which is not built yet: before then the only resolver is a test harness that reads a container binding and refuses to run outside local and testing, so no credential of any kind is accepted in a deployed environment. These endpoints are therefore NOT public, and a client that omits authentication receives 401.",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CreatePagerSessionRequest": {
                "type": "object",
                "description": "The body for creating a pager session: the order reference to print on the ticket.",
                "properties": {
                    "order_reference": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9 \\-_#.\\/]+$",
                        "maxLength": 32
                    }
                },
                "required": [
                    "order_reference"
                ],
                "title": "CreatePagerSessionRequest"
            },
            "ProblemDocument": {
                "type": "object",
                "properties": {
                    "type": {
                        "$ref": "#/components/schemas/ProblemType"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "type",
                    "title",
                    "status",
                    "instance"
                ],
                "title": "ProblemDocument"
            },
            "ProblemType": {
                "type": "string",
                "description": "The vocabulary of `type` values this API can return in an RFC 7807 problem document. Each case is a stable URI, the HTTP status beside it, and a fixed human-readable title. A client may switch on `type`; it is the part of an error response that is contractual.\n",
                "enum": [
                    "https://qrpager.dev/problems/bad-request",
                    "https://qrpager.dev/problems/validation",
                    "https://qrpager.dev/problems/not-found",
                    "https://qrpager.dev/problems/method-not-allowed",
                    "https://qrpager.dev/problems/unauthenticated",
                    "https://qrpager.dev/problems/forbidden",
                    "https://qrpager.dev/problems/conflict",
                    "https://qrpager.dev/problems/expired",
                    "https://qrpager.dev/problems/rate-limited",
                    "https://qrpager.dev/problems/unavailable",
                    "https://qrpager.dev/problems/server-error"
                ],
                "title": "ProblemType"
            },
            "ValidationProblemDocument": {
                "type": "object",
                "properties": {
                    "type": {
                        "$ref": "#/components/schemas/ProblemType"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "instance": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "type",
                    "title",
                    "status",
                    "instance",
                    "errors"
                ],
                "title": "ValidationProblemDocument"
            }
        }
    }
}