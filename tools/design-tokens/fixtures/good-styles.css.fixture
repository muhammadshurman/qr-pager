/* DELIBERATELY RIGHT. None of these may produce a finding. */

/* A comment may name a colour: #0B6B4F, rgb(1,2,3), white, 13px. Comments are stripped
   before matching, because a rule that fires on its own documentation gets disabled. */

.card {
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1px solid var(--color-hairline);          /* a hairline is a device pixel */
  box-shadow: 0 1px 2px var(--color-elevation);     /* the approved elevation */
  padding: var(--space-16);
  padding-inline: var(--space-24) var(--space-24);  /* every part is a token */
  gap: var(--space-8);
  margin: 0;
  inset: auto;
  width: 100%;
  font-size: var(--size-16);
  line-height: var(--leading-body);
  gap: calc(var(--space-16) / 2);                   /* a composition, not a new decision */
  padding-block: clamp(var(--space-8), var(--space-16), var(--space-24));
  transition-duration: var(--motion-state);
}

.card[data-theme='dark'] {
  color: var(--color-ink);
}

@media (min-width: 48rem) {
  /* A breakpoint is a viewport fact, not a design token, and it is not a spacing property. */
  .card { padding: var(--space-32); }
}
