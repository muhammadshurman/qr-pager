#!/usr/bin/env bash
# Runs a command against the repo inside the pinned browser image (tools/browsers/Dockerfile).
#
#   tools/browsers/bin/browsers pnpm exec playwright test
#   tools/browsers/bin/browsers node storage/probe/engines.mjs
#
# WHY A SCRIPT AND NOT A DOCUMENTED `docker run`. Every figure in this task's report has to
# name the toolchain that produced it (the rank-1 brief's trap 5), and a figure produced by a
# command somebody typed from memory names nothing reproducible. This is that command, once.
#
# IT USES A LOCAL BROWSER WHEN THERE IS ONE. `playwright install-deps` on a host with sudo
# makes the container unnecessary, and a wrapper that forced the container anyway would make
# CI slower for no reason -- CI installs the browsers natively (ci.yml, the `frontend` job).
# QRPAGER_BROWSERS=container forces it; QRPAGER_BROWSERS=host forbids it.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
MODE="${QRPAGER_BROWSERS:-auto}"

# The version the workspace pins, read from the lockfile rather than typed. One source.
pw_version() {
  node -e '
const { readFileSync } = require("node:fs")
const pkg = JSON.parse(readFileSync(process.argv[1] + "/package.json", "utf8"))
const want = pkg.devDependencies["@playwright/test"]
if (!/^\d+\.\d+\.\d+$/.test(want)) {
  console.error("browsers: @playwright/test must be pinned exact, got " + want)
  process.exit(1)
}
process.stdout.write(want)
' "$REPO"
}

host_can_launch() {
  node -e '
(async () => {
  const pw = require("playwright")
  for (const name of ["chromium", "firefox", "webkit"]) {
    const b = await pw[name].launch()
    await b.close()
  }
})().catch(() => process.exit(1))
' >/dev/null 2>&1
}

if [ "$#" -eq 0 ]; then
  echo "usage: $(basename "$0") <command> [args...]" >&2
  exit 64
fi

if [ "$MODE" = host ]; then
  exec "$@"
fi

if [ "$MODE" = auto ] && (cd "$REPO" && host_can_launch); then
  echo "browsers: all three engines launch on this host; running natively." >&2
  exec "$@"
fi

if [ "$MODE" = auto ]; then
  echo "browsers: this host cannot launch all three engines; using the container." >&2
fi

PW="$(cd "$REPO" && pw_version)"
IMAGE="qrpager-browsers:pw${PW}"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "browsers: building $IMAGE (once; this takes several minutes)" >&2
  docker build --build-arg "PW_VERSION=${PW}" -t "$IMAGE" "$REPO/tools/browsers"
fi

# ⚠ THE BROWSER VERSIONS ARE PRINTED BEFORE THE COMMAND RUNS, into the command's own output.
# A Playwright figure whose engine build is not beside it has no provenance -- which is the
# argument `§3.1` row 9's method makes about the Lighthouse score, and it applies to every
# assertion this image produces, not only to that one.
mkdir -p "$REPO/storage/browsers-home"

# ⚠ EVERY `QRPAGER_*` VARIABLE IS FORWARDED, BY PATTERN RATHER THAN BY NAME. The first
# version listed `QRPAGER_API_BASE` explicitly and the journey suite failed 18 of 18 inside
# the container with *"QRPAGER_E2E_SESSIONS is unset"* -- a variable the caller had set and
# this script dropped. A named list here is the duplicated-list shape this project has paid
# for three times: the names live in `tools/browsers/bin/e2e` and in the specs, and a
# third copy goes stale the first time one is added.
#
# Scoped to the prefix on purpose: the container gets this project's own configuration and
# not the caller's whole environment, so a credential in some unrelated variable does not
# travel into a process that runs browsers against the network.
#
# ⚠ AND A `127.0.0.1` IN ONE OF THEM IS REWRITTEN TO `host.docker.internal`, BECAUSE
# `--network host` DOES NOT REACH THE HOST's LOOPBACK ON THIS PLATFORM. Measured, both ways,
# against a server bound on the host:
#
#   docker run --rm --network host                        curl 127.0.0.1:8097/healthz  ->  000
#   docker run --rm --add-host=host.docker.internal:host-gateway
#                                        curl host.docker.internal:8097/healthz        ->  200
#
# Docker on WSL2 gives `--network host` a namespace that is not the Windows host's, so the
# first is a connection refused and the journey suite failed 18 of 18 with
# `ERR_CONNECTION_REFUSED` -- against servers that were demonstrably up, because the
# host-side readiness probe had already passed. The rewrite lives HERE, in the one place that
# knows whether the container is being used, so `tools/browsers/bin/e2e` and the specs stay
# ignorant of the transport.
forwarded=()
while IFS= read -r name; do
  value="${!name}"
  forwarded+=(-e "${name}=${value//127.0.0.1/host.docker.internal}")
done < <(compgen -v | grep '^QRPAGER_' || true)

# ⚠ NO IMPLICIT INSTALL INSIDE A MEASUREMENT RUN -- `npm_config_verify_deps_before_run`.
# pnpm 12 verifies node_modules against the lockfile before running a script, and on the
# first container invocation it ran an install that RELINKED node_modules while the suite was
# starting -- so `pnpm exec playwright` failed with "Command not found" against a tree that
# was perfectly installed a second later. A run that mutates its own toolchain cannot be
# measured. The host's `pnpm install` is the one place dependencies are installed.
#
# ⚠ AND THESE ARE PLAIN COMMENTS, NOT `` `# …` `` PSEUDO-COMMENTS INSIDE THE ARGUMENT LIST.
# The first version put them between the `docker run` flags that way; a backtick runs a
# COMMAND SUBSTITUTION, the nested backticks inside the prose broke the nesting, and docker
# received a mangled argv -- it read `QRPAGER_TOOLCHAIN=container` as the env value, the image
# name as the IMAGE, and every remaining flag as the command. The container came up and did
# nothing for three minutes. A comment that can change what a command runs is not a comment.
exec docker run --rm -i \
  --init \
  --ipc=host \
  --user "$(id -u):$(id -g)" \
  -v "$REPO":/repo \
  -v "$REPO/storage/browsers-home":/home/runner \
  -e HOME=/home/runner \
  -e CI="${CI:-}" \
  -e npm_config_verify_deps_before_run=false \
  "${forwarded[@]}" \
  -e QRPAGER_TOOLCHAIN="container=${IMAGE}" \
  --add-host=host.docker.internal:host-gateway \
  --network host \
  -w /repo \
  "$IMAGE" "$@"
