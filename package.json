{
  "name": "qr-pager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "pnpm run lint:es && pnpm run lint:tokens && pnpm run format:check",
    "lint:es": "eslint .",
    "lint:tokens": "node tools/design-tokens/bin/scan-css.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "tokens:generate": "pnpm --filter @qrpager/tokens run generate",
    "tokens:check": "pnpm --filter @qrpager/tokens run check",
    "gate": "node tools/gate/bin/gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@qrpager/eslint-plugin-design-tokens": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
